# Smart Vibration Alarms — environment configuration
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and will never be committed.
#
# IMPORTANT: if your password contains a # character, wrap the whole
# value in double quotes, e.g.  READ_DB_PASSWORD="my#password"

# ── READ connection (source data — read-only user is fine) ───────────────────
READ_DB_HOST=your-server-hostname-or-ip
READ_DB_PORT=1433
READ_DB_NAME=arsl_matthew_gibson
READ_DB_USER=your_read_user
READ_DB_PASSWORD="your_read_password"
READ_DB_TABLE=falcon_scalars

# ── WRITE connection (results table — needs CREATE TABLE + INSERT + UPDATE) ──
WRITE_DB_HOST=your-server-hostname-or-ip
WRITE_DB_PORT=1433
WRITE_DB_NAME=arsl_matthew_gibson
WRITE_DB_USER=your_write_user
WRITE_DB_PASSWORD="your_write_password"
WRITE_DB_OUTPUT_TABLE=smart_alarm_results

# ── Shared ────────────────────────────────────────────────────────────────────
# SQL Server schema — usually "dbo" (the default SQL Server schema)
DB_SCHEMA=dbo
